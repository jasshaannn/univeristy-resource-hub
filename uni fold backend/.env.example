# Copy this file to .env and change the values
PORT=5001

# Admin credentials for logging into the admin portal (/admin)
ADMIN_ID=admin
ADMIN_PASSWORD=change-to-a-secure-password

# Secret key for admin actions / fallback token signing. Pick something long.
ADMIN_KEY=change-me-to-a-secure-random-secret-key

# Frontend origin allowed to call the API (your friend's dev server).
# Vite = http://localhost:5173, Create React App / Next.js = http://localhost:3000
# In production, set this to your deployed frontend domain (e.g. https://your-app.vercel.app)
CORS_ORIGIN=*

# Max upload size in MB
MAX_FILE_MB=50

# Google Drive folder link to sync (optional)
DRIVE_FOLDER_URL=https://drive.google.com/drive/folders/your-folder-id

# Optional: Google Cloud Drive API Key (leave empty to use public scraper)
GOOGLE_API_KEY=
